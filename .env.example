# INVITTA 2.0 BETA — CONFIGURACIÓN EXCLUSIVA DE SUPABASE EN LA NUBE
# Reemplaza estos valores con los de tu NUEVO proyecto independiente de Supabase

# URL de la API de tu nuevo proyecto (Project Settings -> API -> Project URL)
SUPABASE_URL=https://tu-nuevo-proyecto-id.supabase.co

# Clave publicable (Project Settings -> API Keys). SUPABASE_ANON_KEY se acepta
# temporalmente durante la transición, pero las instalaciones nuevas deben usar esta.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave de servicio para administración backend (NO compartir con clientes)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Entrega de imágenes de la revisión publicada: sólo en el servidor y apagada
# hasta verificarla en Preview. No usar una clave publicable ni exponerla al navegador.
# SUPABASE_SECRET_KEY=sb_secret_...
INVITTA_PUBLIC_ASSETS_ENABLED=0
# Requerido incluso en Preview: sólo este proyecto podrá resolver imágenes.
# INVITTA_PUBLIC_ASSET_PREVIEW_SLUG=p-id-del-proyecto

# Vista previa JSON de contenido permitido; independiente de las imágenes y apagada.
# Revisar datos reales antes de activar incluso un solo slug: no es la URL final.
INVITTA_PUBLIC_CONTENT_ENABLED=0
# INVITTA_PUBLIC_CONTENT_PREVIEW_SLUG=p-id-del-proyecto

# Nombre del bucket de almacenamiento para fotos del álbum
STORAGE_BUCKET_NAME=invitta-album-photos
INVITE_JWT_SECRET=            # distinto de SESSION_JWT_SECRET, 32+ bytes
PUBLIC_SITE_URL=https://invitta-2-0.vercel.app
WEDDING_BANK_NAME=
WEDDING_BANK_ACCOUNT=
WEDDING_BANK_HOLDER=
WEDDING_GODPARENTS_JSON=      # ej: ["Nombre 1","Nombre 2"]
WEDDING_VENUE_CHURCH=
WEDDING_VENUE_RECEPTION=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_JWT_SECRET=una-cadena-aleatoria-de-32-caracteres
# Hash bcrypt para el PIN 1234: $2b.NG0I6Zh74ah1dbNFC
EVENT_CATALINA_JULIAN_PIN_HASH=$2b$10$HcpYqSR1E90yBcxFW5ka9OQUipgpBL50Tg1.NG0I6Zh74ah1dbNFC
