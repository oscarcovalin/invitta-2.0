{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api-gw.payclip.com https://www.clip.mx; frame-ancestors 'none';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/landing",
      "destination": "/index.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/estudio",
      "destination": "/invitacion-estudio.html"
    },
    {
      "source": "/invitacion-estudio",
      "destination": "/invitacion-estudio.html"
    },
    {
      "source": "/pago-exitoso",
      "destination": "/pago-exitoso.html"
    },
    {
      "source": "/pago-pendiente",
      "destination": "/pago-pendiente.html"
    },
    {
      "source": "/invitacion",
      "destination": "/invitacion.html"
    },
    {
      "source": "/invitacion-boda",
      "destination": "/invitacion-boda.html"
    },
    {
      "source": "/invitacion-xv",
      "destination": "/invitacion-xv.html"
    },
    {
      "source": "/mesas",
      "destination": "/organizador-mesas"
    },
    {
      "source": "/organizador",
      "destination": "/organizador-mesas"
    },
    {
      "source": "/organizador-mesas",
      "destination": "/organizador-mesas.html"
    },
    {
      "source": "/scanner",
      "destination": "/scanner-acceso"
    },
    {
      "source": "/scanner-acceso",
      "destination": "/scanner-acceso.html"
    },
    {
      "source": "/express",
      "destination": "/generador-emergencia"
    },
    {
      "source": "/generador-emergencia",
      "destination": "/generador-emergencia.html"
    },
    {
      "source": "/catering",
      "destination": "/catering-module/catering-tactical-sheet.html"
    }
  ]
}
